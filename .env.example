# Server-only OpenAI API key for script writing.
# Never commit a real API key or expose it to NEXT_PUBLIC_* variables.
OPENAI_API_KEY=
HTMLVIDEO_SCRIPT_LLM_BASE_URL=https://api.openai.com/v1
HTMLVIDEO_SCRIPT_LLM_MODEL=gpt-6-luna
HTMLVIDEO_SCRIPT_LLM_REASONING_EFFORT=high
HTMLVIDEO_SCRIPT_LLM_SERVICE_TIER=fast
HTMLVIDEO_SCRIPT_LLM_FALLBACK_MODELS=
HTMLVIDEO_SCRIPT_LLM_STANDARD=openai

# Optional transcript ingestion service. This local service must be installed
# separately and listening on port 3000 when URL-to-transcript is used.
MAIVIDEO_HTMLVIDEO_BASE_URL=http://127.0.0.1:3000
MAIVIDEO_CRAWL_PATH=/api/crawl-url
MAIVIDEO_CRAWL_TIMEOUT_MS=720000

# Stock-first media pipeline. Keep credentials server-side only.
PEXELS_API_KEY=
PEXELS_KEYS_TEXT=

# MaiVideo public image API, also used when image generation is selected.
MAIVIDEO_BASE_URL=https://maivideo.top
MAIVIDEO_API_KEY=
MAIVIDEO_IMAGE_MODEL=gpt-image-2.5-flare
MAIVIDEO_IMAGE_QUALITY=1440p

# /projects/new reads the live MaiVideo video catalog and prefers v6 at 720p.
# Seedance through the local Dola Render Gateway remains selectable there.
MAIVIDEO_VIDEO_API_PATH=/api/v1/video-generation
MAIVIDEO_VIDEO_STATUS_PATH=/api/v1/video-generation
MAIVIDEO_SESSION_TOKEN=
MAIVIDEO_SESSION_ID=
MAIVIDEO_ALLOW_GLOBAL_SESSION=false
# Global fallback settings for other media flows; /projects/new uses its
# catalog-backed defaults above rather than these model and quality values.
MAIVIDEO_VIDEO_MODEL=seedance-2.5
# Seedance accepts up to 30 character images per scene; MaiVideo models may accept fewer.
# Leave empty to infer the limit from MAIVIDEO_VIDEO_MODEL.
MAIVIDEO_VIDEO_MAX_REFERENCE_IMAGES=
MAIVIDEO_VIDEO_QUALITY=1080p
MAIVIDEO_VIDEO_DURATION=5

# Local Dola Gateway settings. The setup script writes per-computer values to
# .env.local and keeps the gateway bound to loopback.
STORYAI_SEEDANCE_BACKEND=dola-gateway
STORYAI_SEEDANCE_GATEWAY_URL=http://127.0.0.1:8210
STORYAI_LOCAL_BASE_URL=http://127.0.0.1:3021
DOLA_GATEWAY_URL=http://127.0.0.1:8210
DOLA_GATEWAY_API_KEY=
# Local setup creates matching random admin keys for the Gateway and its UI.
DOLA_ADMIN_KEY=
DOLA_GATEWAY_ADMIN_KEY=
NEXT_PUBLIC_DOLA_STUDIO_URL=http://127.0.0.1:3117
STORYAI_PORT=3021
DOLA_STUDIO_PORT=3117
DOLA_GATEWAY_PORT=8210

# Secret used to encrypt local API credentials and sign short-lived reference
# image URLs. The first npm run dev generates and stores a random local value.
STORYAI_CREDENTIALS_ENCRYPTION_KEY=
SEEDANCE_CREDENTIALS_ENCRYPTION_KEY=
# MaiVideo identity and image API. These defaults allow a local install to
# authenticate against MaiVideo.com without another local service.
MAIVIDEO_AUTH_BASE_URL=https://maivideo.top
MAIVIDEO_AUTH_LOCAL_BASE_URL=https://maivideo.top
MAIVIDEO_AUTH_COOKIE=maivideo_auth
MAIVIDEO_AUTH_TIMEOUT_MS=10000
MAIVIDEO_AUTH_CACHE_TTL_MS=30000
# Only needed when switching STORYAI_SEEDANCE_BACKEND to seedance-api.
STORYAI_PUBLIC_BASE_URL=
SEEDANCE_VIDEO_TIMEOUT_MS=1800000

STORYAI_MEDIA_CONCURRENCY=2
MAIVIDEO_POLL_INTERVAL_MS=4000
