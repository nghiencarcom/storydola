# Server-only OpenAI API key for script writing.
# Never commit a real API key or expose it to NEXT_PUBLIC_* variables.
OPENAI_API_KEY=
HTMLVIDEO_SCRIPT_LLM_BASE_URL=https://api.openai.com/v1
HTMLVIDEO_SCRIPT_LLM_MODEL=gpt-6-luna
HTMLVIDEO_SCRIPT_LLM_REASONING_EFFORT=high
HTMLVIDEO_SCRIPT_LLM_SERVICE_TIER=fast
HTMLVIDEO_SCRIPT_LLM_FALLBACK_MODELS=
HTMLVIDEO_SCRIPT_LLM_STANDARD=openai

# MaiVideo transcript ingestion. Set this to the reachable htmlvideo service.
MAIVIDEO_HTMLVIDEO_BASE_URL=http://127.0.0.1:3000
MAIVIDEO_CRAWL_PATH=/api/crawl-url
MAIVIDEO_CRAWL_TIMEOUT_MS=720000

# Stock-first media pipeline. Keep credentials server-side only.
PEXELS_API_KEY=
PEXELS_KEYS_TEXT=

# MaiVideo public image API (used as the image fallback in stock-mixed mode).
MAIVIDEO_BASE_URL=https://maivideo.top
MAIVIDEO_API_KEY=
MAIVIDEO_IMAGE_MODEL=gemini-nano-banana-2.1
MAIVIDEO_IMAGE_QUALITY=1440p

# MaiVideo public video API. It authenticates with MAIVIDEO_API_KEY and does
# not require a browser session/cookie. Stock-mixed mode remains stock-first
# by default.
MAIVIDEO_VIDEO_API_ENABLED=false
MAIVIDEO_VIDEO_API_PATH=/api/v1/video-generation
MAIVIDEO_VIDEO_STATUS_PATH=/api/v1/video-generation
MAIVIDEO_SESSION_TOKEN=
MAIVIDEO_SESSION_ID=
MAIVIDEO_ALLOW_GLOBAL_SESSION=false
MAIVIDEO_VIDEO_MODEL=v6
# Seedance accepts up to 30 character images per scene; MaiVideo models may accept fewer.
# Leave empty to infer the limit from MAIVIDEO_VIDEO_MODEL.
MAIVIDEO_VIDEO_MAX_REFERENCE_IMAGES=
MAIVIDEO_VIDEO_QUALITY=1080p
MAIVIDEO_VIDEO_DURATION=5

# Encryption secret for personal Seedance API keys. Generate once per installation
# with: openssl rand -hex 32. Keep it stable to retain access to saved accounts.
# This same secret encrypts the MaiVideo login session stored for Higgsfield jobs,
# so those jobs can resume polling after the server restarts.
SEEDANCE_CREDENTIALS_ENCRYPTION_KEY=
# MaiVideo account sign-in. Local StoryAI uses production by default so its
# session identity matches public Seedance API keys. Set this to a separate
# local MaiVideo instance only when intentionally developing against it.
MAIVIDEO_AUTH_BASE_URL=https://maivideo.top
MAIVIDEO_AUTH_LOCAL_BASE_URL=https://maivideo.top
MAIVIDEO_AUTH_COOKIE=maivideo_auth
MAIVIDEO_AUTH_TIMEOUT_MS=10000
MAIVIDEO_AUTH_CACHE_TTL_MS=30000
# Public HTTPS origin used when Seedance fetches scene, character, location, or storyboard references.
STORYAI_PUBLIC_BASE_URL=
SEEDANCE_VIDEO_TIMEOUT_MS=1800000

# Optional private-access secret for the Higgsfield video endpoint. Leave blank
# unless the MaiVideo server has private Higgsfield access enabled.
HIGGSFIELD_ACCESS_TOKEN=
HIGGSFIELD_VIDEO_TIMEOUT_MS=86400000
HIGGSFIELD_VIDEO_POLL_INTERVAL_MS=10000

STORYAI_MEDIA_CONCURRENCY=2
MAIVIDEO_POLL_INTERVAL_MS=4000
