# Next.js dashboard
PORT=3117

# Dola Render Gateway. Run the gateway on a separate port because MaiVideo
# already uses 8000 for its backend.
DOLA_GATEWAY_URL=http://127.0.0.1:8210
DOLA_GATEWAY_API_KEY=
# Optional: must match DOLA_ADMIN_KEY in the Gateway for account management
DOLA_GATEWAY_ADMIN_KEY=
# Stable server-only HMAC secret used to scope render tasks to MaiVideo users.
# Keep this value unchanged after tasks have been created.
DOLA_TASK_OWNER_SECRET=
DOLA_GATEWAY_PUBLIC_URL=http://127.0.0.1:8210

# MaiVideo production API base used by Dola for API, login, and media requests.
# Optional server-side MaiVideo auth token. The browser picker can also store
# a token for the current session only, so it is not required here.
MAIVIDEO_AUTH_TOKEN=
# Optional public API key for server-side PixVerse image generation. A logged-
# in MaiVideo session token is used when this is empty.
MAIVIDEO_API_KEY=
# Sketch mode uses Nano Banana 2 by default. Nano Banana Pro remains available as an override.
MAIVIDEO_IMAGE_MODEL=gemini-3.1-flash
MAIVIDEO_IMAGE_QUALITY=1440p
HTMLVIDEO_LOCAL_URL=http://127.0.0.1:3000
FB_LOCAL_URL=http://127.0.0.1:4242

# Production MaiVideo API base used by all Dola-to-MaiVideo requests.
MAIVIDEO_PUBLIC_URL=https://maivideo.top
# Other public hostnames shown in the Connections screen.
HTMLVIDEO_PUBLIC_URL=https://html.maivideo.top
FB_PUBLIC_URL=https://fb.maivideo.top
DOLA_PUBLIC_URL=https://seedance.maivideo.top
