# Local StoryAI-Dola ports. The Gateway must stay bound to loopback.
DOLA_HOST=127.0.0.1
DOLA_PORT=8210
DOLA_PUBLIC_BASE=http://127.0.0.1:8210
DOLA_STUDIO_URL=http://127.0.0.1:3117
STORYAI_LOCAL_URL=http://127.0.0.1:3021

# Optional authentication. If set, mirror the keys in the Studio .env.local.
DOLA_API_KEYS=
DOLA_ADMIN_KEY=

# Allow up to 30 concurrent video renders.
DOLA_MAX_CONCURRENCY=30
DOLA_MAX_PENDING_TASKS=100

# Browser automation.
DOLA_EXTENSION_DIR=extensions/SeedancePro
DOLA_EXTENSION_ENABLED=1
# Leave empty for the computer's normal network, or provide your own proxy URL.
DOLA_PROXY=

# MaiVideo image generation used by the pencil-sketch mode.
MAIVIDEO_PUBLIC_URL=https://maivideo.top
MAIVIDEO_IMAGE_MODEL=gemini-3.1-flash
MAIVIDEO_IMAGE_QUALITY=1440p
