# Replace OWNER/REPOSITORY with the account and repository where the StoryAI
# container image is published. Keep the registry package public for users who
# should not need a GitHub login.
STORYAI_IMAGE=ghcr.io/OWNER/REPOSITORY:latest

# Local web access. Set STORYAI_BIND_HOST=0.0.0.0 only when other devices on
# your trusted LAN need to connect to this installation.
STORYAI_BIND_HOST=127.0.0.1
STORYAI_PORT=3011
STORYAI_UID=1000
STORYAI_GID=1000

# The launcher creates a random key on first start. Keep it in this file and
# include it in encrypted backups; losing it prevents reading saved API keys.
SEEDANCE_CREDENTIALS_ENCRYPTION_KEY=GENERATE_ON_FIRST_START

# Optional server-side API keys.
OPENAI_API_KEY=
PEXELS_API_KEY=
MAIVIDEO_API_KEY=

# Docker Desktop can use host.docker.internal to reach services on this computer.
# On Linux or when services are hosted elsewhere, set these to their reachable URLs.
STORYAI_HTMLVIDEO_BASE_URL=http://host.docker.internal:3000
STORYAI_OMNIVOICE_BASE_URL=http://host.docker.internal:8000

# Public HTTPS URL is required only for provider workflows that fetch references
# from this StoryAI installation.
STORYAI_PUBLIC_BASE_URL=

HTMLVIDEO_SCRIPT_LLM_BASE_URL=https://api.openai.com/v1
HTMLVIDEO_SCRIPT_LLM_MODEL=gpt-6-luna
HTMLVIDEO_SCRIPT_LLM_REASONING_EFFORT=high
HTMLVIDEO_SCRIPT_LLM_SERVICE_TIER=fast
HTMLVIDEO_SCRIPT_LLM_STANDARD=openai

MAIVIDEO_BASE_URL=https://maivideo.top
MAIVIDEO_AUTH_BASE_URL=https://maivideo.top
MAIVIDEO_AUTH_LOCAL_BASE_URL=https://maivideo.top
MAIVIDEO_CRAWL_PATH=/api/crawl-url
MAIVIDEO_CRAWL_TIMEOUT_MS=720000

STORYAI_MEDIA_CONCURRENCY=2
MAIVIDEO_POLL_INTERVAL_MS=4000
