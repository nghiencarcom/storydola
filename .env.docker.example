# Public image for the StoryAI distribution. The launcher checks this tag on
# every start and downloads a newer image when one is available.
STORYAI_IMAGE=ghcr.io/nghiencarcom/storydola:latest

# Local web access. Set STORYAI_BIND_HOST=0.0.0.0 only when other devices on
# your trusted LAN need to connect to this installation.
STORYAI_BIND_HOST=127.0.0.1
STORYAI_PORT=3012
STORYAI_UID=1000
STORYAI_GID=1000

# The launcher creates a random key on first start. Keep it in this file and
# include it in encrypted backups; losing it prevents reading saved API keys.
SEEDANCE_CREDENTIALS_ENCRYPTION_KEY=GENERATE_ON_FIRST_START

# Optional server-side API keys.
OPENAI_API_KEY=
PEXELS_API_KEY=
MAIVIDEO_API_KEY=

# Docker Desktop can use host.docker.internal to reach HTMLVideo on this computer.
# On Linux or when HTMLVideo is hosted elsewhere, set this to its reachable URL.
STORYAI_HTMLVIDEO_BASE_URL=http://host.docker.internal:3000

# Seedance reference images are sent inline as Data URIs; no public StoryAI URL is needed.

HTMLVIDEO_SCRIPT_LLM_BASE_URL=https://api.openai.com/v1
HTMLVIDEO_SCRIPT_LLM_MODEL=gpt-6-luna
HTMLVIDEO_SCRIPT_LLM_REASONING_EFFORT=high
HTMLVIDEO_SCRIPT_LLM_SERVICE_TIER=fast
HTMLVIDEO_SCRIPT_LLM_STANDARD=openai

MAIVIDEO_BASE_URL=https://maivideo.top
MAIVIDEO_AUTH_BASE_URL=https://maivideo.top
MAIVIDEO_AUTH_LOCAL_BASE_URL=https://maivideo.top
MAIVIDEO_CRAWL_PATH=/api/crawl-url
MAIVIDEO_CRAWL_TIMEOUT_MS=720000

STORYAI_MEDIA_CONCURRENCY=2
MAIVIDEO_POLL_INTERVAL_MS=4000

# Automatic UGC drafting runs with the installed local CLI (Codex first by default).
# Set to codex, claude, or antigravity to pin a specific CLI; blank auto-detects.
STORYAI_SALES_UGC_AGENT=

# Optional fal key for the HeyGen voice-cloning step of the narrated pose template.
FAL_KEY=

# PixVerse Platform API key for sales-video generation and reference video editing.
PIXVERSE_API_KEY=
# Optional absolute path to the rea-video CLI for shot analysis. FFmpeg is the default.
STORYAI_REA_VIDEO_PATH=

# Set false on development machines to preserve local source without pulling main.
STORYAI_AUTO_UPDATE=true
